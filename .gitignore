# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sanity
/.sanity/

# Local Agenda demo activities and their one-off bootstrap/verification tooling
/sanity/seed/agenda-preview-activities.*
/sanity/seed/publish-preview-activities.mjs
/openspec/changes/agenda-activities/verification-report-activity-seed.md
/openspec/changes/agenda-activities/verification/integration-checks.mjs
/openspec/changes/agenda-activities/verification/remote-document-checks.mjs
/openspec/changes/agenda-activities/verification/sanity-browser-checks.mjs
/openspec/changes/agenda-activities/verification/sanity-live-checks.mjs
/openspec/changes/agenda-activities/verification/seed-checks.mjs
